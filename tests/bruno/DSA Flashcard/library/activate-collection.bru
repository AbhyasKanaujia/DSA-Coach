meta {
  name: Activate Collection
  type: http
  seq: 3
  tags: [
    library
  ]
}

patch {
  url: {{baseUrl}}/library/{{collectionId}}/activate
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

tests {
  function onResponse(request, response) {
    expect(response.status).to.equal(200);
    expect(response.body).to.have.property('isActive');
    expect(response.body.isActive).to.equal(true);
  }
}

docs {
  Activate a collection in the user's library.

  Only active collections' problems appear in study sessions.
}