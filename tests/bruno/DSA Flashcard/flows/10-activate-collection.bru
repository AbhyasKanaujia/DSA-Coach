meta {
  name: Flow 10 - User Activates Collection
  type: http
  seq: 10
  tags: [
    flows
    e2e
  ]
}

patch {
  url: {{baseUrl}}/library/{{flowCollectionId}}/activate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{flowAuthToken}}
}

headers {
  Content-Type: application/json
}

tests {
  function onResponse(request, response) {
    expect(response.status).to.equal(200);
    expect(response.body).to.have.property('isActive');
    expect(response.body.isActive).to.equal(true);
  }
}

docs {
  Step 10: User activates the collection in their library.

  Activation is required for the collection's problems to appear in sessions.
}