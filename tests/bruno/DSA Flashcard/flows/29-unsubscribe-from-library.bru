meta {
  name: Flow 29 - User Unsubscribes From Collection
  type: http
  seq: 29
  tags: [
    flows
    e2e
    library
  ]
}

delete {
  url: {{baseUrl}}/library/{{flowCollectionId2}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{flowAuthToken}}
}

headers {
  Content-Type: application/json
}

tests {
  function onResponse(request, response) {
    expect(response.status).to.equal(204);
  }
}

docs {
  Step 29: User unsubscribes from the second collection.

  The DELETE /library/:collectionId endpoint removes the subscription.
  User progress (UserProblemState) is NOT affected by this operation.
}