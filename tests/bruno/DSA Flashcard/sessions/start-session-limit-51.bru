meta {
  name: Start Session - Limit Over Max
  type: http
  seq: 6
  tags: [
    sessions
    negative
  ]
}

post {
  url: {{baseUrl}}/sessions/start
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "limit": 51
  }
}

tests {
  function onResponse(request, response) {
    expect(response.status).to.equal(400);
    expect(response.body).to.have.property('field');
    expect(response.body.field).to.equal('limit');
  }
}

docs {
  Verify that limit=51 (above max of 50) is rejected.
}