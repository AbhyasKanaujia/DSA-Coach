meta {
  name: Update Problem Metadata
  type: http
  seq: 5
  tags: [
    problems
    admin
  ]
}

put {
  url: {{baseUrl}}/problems/{{problemId}}/metadata
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Two Sum - Updated",
    "difficulty": "medium",
    "tags": ["array", "hash-table", "two-pointers"],
    "companies": ["google", "amazon", "meta"]
  }
}

tests {
  function onResponse(request, response) {
    expect(response.status).to.equal(200);
    expect(response.body.title).to.equal('Two Sum - Updated');
    expect(response.body.difficulty).to.equal('medium');
  }
}

docs {
  Update problem metadata (title, description, difficulty, tags, companies). Admin only.
}