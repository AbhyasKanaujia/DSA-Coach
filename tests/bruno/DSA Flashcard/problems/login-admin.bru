meta {
  name: Login Admin
  type: http
  seq: 1
  tags: [
    problems
    setup
  ]
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar('adminToken', res.body.token, { persist: true });
  }
}

tests {
  function onResponse(request, response) {
    expect(response.status).to.equal(200);
    expect(response.body).to.have.property('token');
  }
}

docs {
  Login as admin to get admin token for problem management endpoints.
}